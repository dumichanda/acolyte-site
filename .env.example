# Copy to .env and fill in. Never commit .env.

# Neon: Project -> Connect -> copy the connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Adzuna: developer.adzuna.com -> Dashboard -> API Access Details
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Total calls this project may ever make. Test accounts get 25; raise after upgrading your plan.
ADZUNA_CALL_BUDGET=20

# Claude: web job search (claude_jobs.py), plus optional classification (--claude) and commentary (--claude)
ANTHROPIC_API_KEY=
WEB_SEARCH_TERMS_PER_RUN=5
JOB_SEARCH_MODEL=claude-opus-5-5
